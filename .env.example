# ── ResuListic Environment Variables ──────────────────────────
# Copy this file to .env and fill in your local paths.
# On Linux/Mac these are usually on PATH already — leave them unset.

# Windows only: path to Tesseract OCR executable
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Windows only: path to Poppler bin folder (needed for scanned PDF → image)
# POPPLER_PATH=C:\poppler-26.02.0\Library\bin

# ── Database ────────────────────────────────────────────────
# Replace the placeholders locally. Never commit a populated URI.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resulistic_db"

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
MAX_UPLOAD_BYTES="10485760"
